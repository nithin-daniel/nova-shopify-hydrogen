# NOVA storefront environment. Copy to .env and adjust.

# true  = local mock Storefront + Customer Account APIs (no Shopify credentials)
# false = talk to PUBLIC_STORE_DOMAIN
DEMO_MODE=true

# Live mode. A *.mock.shop domain works tokenless, e.g. gadgets.mock.shop
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# Leave the token commented out for tokenless access (mock.shop). An empty
# assignment is rejected by the Storefront client.
# PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=0
PUBLIC_CHECKOUT_DOMAIN=

# Customer Account API (live mode only; needs an HTTPS origin)
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
CUSTOMER_ACCOUNT_SESSION_SECRET=change-me-to-a-long-random-string

# Mock API latency (ms) so optimistic UI is visible in demo mode
MOCK_API_QUERY_LATENCY_MS=25
MOCK_API_MUTATION_LATENCY_MS=350
